---
import CapXValue from './CapXValue.astro';
import AhlaCashflow from './AhlaCashflow.astro';
import ArchiTech from './ArchiTech.astro';
import { useTranslations, type Lang } from '../i18n';
import { showArchitech } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang).projects;
---

<section id="projets" aria-labelledby="projets-title">
  <div class:list={['wrap', 'sec-head', { solo: !showArchitech }]}>
    <h2 id="projets-title">{showArchitech ? t.title : t.titleTwo}</h2>
    {showArchitech && <p>{t.intro}</p>}
  </div>
  <CapXValue lang={lang} />
  <AhlaCashflow lang={lang} />
  {showArchitech && <ArchiTech lang={lang} />}
</section>
