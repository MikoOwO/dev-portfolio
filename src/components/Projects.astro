---
import CapXValue from './CapXValue.astro';
import AhlaCashflow from './AhlaCashflow.astro';
import ArchiTech from './ArchiTech.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang).projects;
---

<section id="projets" aria-labelledby="projets-title">
  <div class="wrap sec-head">
    <h2 id="projets-title">{t.title}</h2>
    <p>{t.intro}</p>
  </div>
  <CapXValue lang={lang} />
  <AhlaCashflow lang={lang} />
  <ArchiTech lang={lang} />
</section>
