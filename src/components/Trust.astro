---
/* Bandeau « Ils nous font confiance » : logos des clients et produits, cliquables. */
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang).trust;

const logos = [
  { name: 'Capinvest Partners', src: '/images/logo-capinvest.webp', width: 968, height: 335, href: 'https://capinvest-partners.com' },
  { name: 'CapXValue', src: '/images/logo-capxvalue.webp', width: 567, height: 120, href: 'https://capxvalue.com' },
  { name: 'Ahla', src: '/images/logo-ahla.webp', width: 163, height: 80, href: 'https://ahlapp.com' },
];
---

<section class="trust" aria-labelledby="trust-title">
  <div class="wrap">
    <h2 id="trust-title" class="trust-title">{t.title}</h2>
    <ul class="trust-logos">
      {logos.map((l) => (
        <li>
          <a href={l.href} target="_blank" rel="noopener" aria-label={l.name}>
            <img src={l.src} width={l.width} height={l.height} alt={l.name} loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust{padding-block:clamp(48px, 6vw, 72px); border-top:1px solid var(--line)}
  .trust-title{font-size:clamp(20px, 2vw, 26px); font-weight:650; letter-spacing:-.015em; color:var(--ink-soft); margin-bottom:28px}
  .trust-logos{list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; align-items:center; gap:clamp(28px, 5vw, 64px)}
  .trust-logos a{display:block; border-radius:8px; transition:opacity .2s ease}
  .trust-logos a:hover{opacity:.8}
  .trust-logos img{height:auto; width:auto; max-height:56px; max-width:220px}
  .trust-logos li:nth-child(3) img{max-height:44px}
</style>
