---
/*
 * « Tenez la caisse d'octobre » : cinq décisions de trésorerie,
 * seuil de caisse 15 000 €, budget 45 000 €, 1 bloc = 2 000 €.
 */
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang).game;
---

<div class="wrap game" id="game" data-strings={JSON.stringify(t.client)}>
  <div class="game-stage">
    <canvas id="cashCanvas" role="img" aria-label={t.canvasLabel}></canvas>
    <div class="game-legend" aria-hidden="true">
      <span><i class="sw-cash"></i>{t.legend.cash}</span>
      <span><i class="sw-jar"></i>{t.legend.jar}</span>
      <span><i class="sw-warn"></i>{t.legend.warn}</span>
    </div>
    <span class="plan-note game-drag" aria-hidden="true">{t.drag}</span>
  </div>
  <div class="game-panel">
    <div>
      <h4>{t.title}</h4>
      <p class="game-rules">{t.rules}</p>
    </div>
    <div class="ticks" id="ticks" aria-hidden="true"></div>
    <div class="tx" id="tx">
      <p class="tx-meta"><span id="txDate" class="num"></span><span id="txCat"></span></p>
      <p class="tx-desc" id="txDesc"></p>
      <p class="tx-amt num" id="txAmt"></p>
      <p class="tx-flag" id="txFlag"></p>
      <div class="tx-actions">
        <button type="button" class="btn primary" id="gPay"></button>
        <button type="button" class="btn" id="gDefer"></button>
      </div>
    </div>
    <div class="mail-card" id="mailCard" hidden>
      <p class="mail-from">{t.mailFrom}</p>
      <p class="mail-verdict" id="mailVerdict"></p>
      <ul class="checks" id="mailChecks"></ul>
      <dl class="mail-figs" id="mailFigs"></dl>
      <button type="button" class="btn primary" id="gReplay">{t.replay}</button>
    </div>
    <dl class="game-stats">
      <div><dt>{t.stats.cash}</dt><dd class="num" id="sCash"></dd></div>
      <div><dt>{t.stats.budget}</dt><dd class="num" id="sBudget"></dd></div>
      <div><dt>{t.stats.deferred}</dt><dd class="num" id="sDefer"></dd></div>
    </dl>
    <p class="sr" id="gLive" aria-live="polite"></p>
  </div>
</div>

<style>
  .game{display:grid; grid-template-columns:minmax(0, 7fr) minmax(0, 5fr); gap:clamp(24px, 3vw, 40px); margin-top:clamp(64px, 8vw, 112px); padding-top:clamp(40px, 5vw, 64px); border-top:1px dashed var(--line)}
  .game-stage{position:relative; border:1px solid var(--line); border-radius:20px; overflow:hidden; min-height:560px; background:radial-gradient(90% 80% at 50% 10%, var(--surface) 0%, var(--bg-deep) 100%)}
  #cashCanvas{position:absolute; inset:0; width:100%; height:100%; display:block; cursor:grab; touch-action:pan-y}
  #cashCanvas:active{cursor:grabbing}
  .game-legend{position:absolute; left:16px; top:16px; display:flex; flex-direction:column; gap:6px; font-family:var(--display); font-size:13px; color:var(--ink-soft); pointer-events:none}
  .game-legend span{display:flex; align-items:center; gap:8px}
  .game-legend i{width:12px; height:12px; border-radius:3px; display:inline-block}
  .sw-cash{background:var(--accent)} .sw-jar{background:#3E78C2} .sw-warn{background:var(--warn)}
  .game-drag{position:absolute; right:16px; bottom:16px; pointer-events:none}
  .game-panel{display:flex; flex-direction:column; gap:20px; min-width:0}
  .game-panel h4{font-family:var(--display); font-weight:700; font-size:clamp(26px, 2.4vw, 34px); letter-spacing:-.03em; line-height:1.1; margin:0}
  .game-rules{color:var(--ink-soft); font-size:16px; margin-top:10px}
  .ticks{display:grid; grid-auto-flow:column; grid-auto-columns:1fr; gap:4px}
  .ticks :global(i){height:5px; border-radius:3px; background:var(--line); transition:background-color .3s ease}
  .ticks :global(i.paid){background:var(--accent)} .ticks :global(i.deferred){background:var(--ink-faint)} .ticks :global(i.cur){background:var(--ink)}
  .tx, .mail-card{background:var(--ink); color:var(--bg-deep); border-radius:18px; padding:22px; font-family:var(--display)}
  .tx{animation:txIn .45s var(--ease-out) both}
  @keyframes txIn{from{opacity:0; transform:translateY(10px) rotateX(-12deg)} to{opacity:1; transform:none}}
  .tx-meta{display:flex; justify-content:space-between; gap:12px; font-size:14px; color:color-mix(in srgb, var(--bg-deep) 65%, transparent)}
  .tx-desc{font-size:20px; font-weight:650; letter-spacing:-.01em; line-height:1.25; margin-top:10px}
  .tx-amt{font-size:40px; font-weight:700; letter-spacing:-.03em; line-height:1.1; margin-top:8px}
  .tx-amt.in{color:#0B7A55} .tx-amt.out{color:#B03A1E}
  .tx-flag{font-size:14px; margin-top:8px; color:color-mix(in srgb, var(--bg-deep) 75%, transparent); min-height:1.4em}
  .tx-actions{display:flex; flex-wrap:wrap; gap:10px; margin-top:18px}
  .tx-actions .btn{min-height:48px; font-size:15px; padding:0 18px; border-radius:12px}
  .tx-actions .btn:not(.primary){border-color:color-mix(in srgb, var(--bg-deep) 25%, transparent); color:var(--bg-deep)}
  .tx-actions .btn.primary{background:var(--bg-deep); border-color:var(--bg-deep); color:var(--ink)}
  .tx-actions .btn:disabled{opacity:.4; cursor:not-allowed; transform:none}
  .tx-actions .btn[hidden]{display:none}
  .mail-from{font-size:14px; color:color-mix(in srgb, var(--bg-deep) 65%, transparent)}
  .mail-verdict{font-size:22px; font-weight:700; letter-spacing:-.02em; line-height:1.25; margin-top:8px}
  .checks{list-style:none; margin:14px 0 0; padding:0; display:grid; gap:8px; font-size:15px}
  .checks :global(li){display:flex; gap:10px; align-items:flex-start}
  .checks :global(svg){width:18px; height:18px; flex:none; margin-top:2px}
  .checks :global(.ok svg){color:#0B7A55} .checks :global(.ko svg){color:#B03A1E}
  .mail-figs{display:grid; grid-template-columns:1fr 1fr; gap:10px 16px; margin:16px 0 18px; padding-top:14px; border-top:1px solid color-mix(in srgb, var(--bg-deep) 15%, transparent)}
  .mail-figs :global(dt){font-size:13px; color:color-mix(in srgb, var(--bg-deep) 60%, transparent)}
  .mail-figs :global(dd){margin:0; font-weight:700; font-size:17px}
  .mail-card .btn.primary{background:var(--bg-deep); border-color:var(--bg-deep); color:var(--ink); min-height:48px; font-size:15px}
  .game-stats{display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:1px; margin:0; background:var(--line); border:1px solid var(--line); border-radius:14px; overflow:hidden}
  .game-stats div{background:var(--bg); padding:14px 16px}
  .game-stats dt{font-family:var(--display); font-size:13px; color:var(--ink-faint)}
  .game-stats dd{margin:2px 0 0; font-family:var(--display); font-weight:700; font-size:19px; letter-spacing:-.02em}
  .game-stats dd.warn{color:var(--warn)}
  @media (max-width:960px){ .game{grid-template-columns:1fr} .game-stage{min-height:420px} }
</style>

<script>
  import { byId, reducedMotion as reduced } from '../scripts/motion';
  import { createCashScene, type CashScene } from '../scripts/cash-scene';
  import { fill, readStrings } from '../scripts/i18n';
  import type { GameStrings } from '../i18n';

  type Kind = 'in' | 'must' | 'urgent' | 'opt';
  interface CashEvent { amt: number; k: Kind }

  /*
   * Cinq décisions qui pèsent chacune sur un critère du bilan :
   * payer la chaudière évite la pénalité, reporter le mobilier garde la caisse
   * au-dessus du seuil et les dépenses dans le budget.
   */
  const START = 30000, SEUIL = 15000, BUDGET = 45000, UNIT = 2000;
  // les textes (date, libellé, catégorie) suivent le même ordre dans game.client.events des dictionnaires
  const EVENTS: CashEvent[] = [
    { amt: 28000, k: 'in' },      // loyers, bâtiment A
    { amt: 32000, k: 'must' },    // salaires
    { amt: 6500, k: 'urgent' },   // chaudière
    { amt: 14000, k: 'opt' },     // mobilier
    { amt: 22000, k: 'in' },      // loyers, bâtiment B
  ];
  const T = readStrings<GameStrings>(byId('game'));
  const ICON_OK = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
  const ICON_KO = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>';

  const money = new Intl.NumberFormat(T.locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
  const percent = new Intl.NumberFormat(T.locale, { style: 'percent', maximumFractionDigits: 0 });
  const eur = (n: number) => money.format(Math.round(n));
  const pctOf = (n: number) => percent.format(Math.round(n) / 100);

  const ticks = byId('ticks'), tx = byId('tx'), mail = byId('mailCard'), live = byId('gLive');
  const pay = byId<HTMLButtonElement>('gPay'), defer = byId<HTMLButtonElement>('gDefer'), replay = byId<HTMLButtonElement>('gReplay');
  ticks.innerHTML = EVENTS.map(() => '<i></i>').join('');
  const tickEls = [...ticks.children];

  let scene: CashScene | null = null;
  try {
    scene = createCashScene(byId<HTMLCanvasElement>('cashCanvas'), {
      seuil: SEUIL, budget: BUDGET, unit: UNIT,
      labels: {
        cash: T.scene.cash, jar: T.scene.jar,
        seuil: fill(T.scene.seuil, { amount: eur(SEUIL) }), budget: fill(T.scene.budget, { amount: eur(BUDGET) }),
      },
    });
  } catch (err) {
    // sans WebGL, le jeu reste jouable avec le panneau seul
    console.warn('Scène 3D indisponible', err);
  }

  interface State { i: number; cash: number; spent: number; deferred: number; urgentDeferred: number; minCash: number }
  let s: State;
  let busy = false;

  function reset(): void {
    s = { i: 0, cash: START, spent: 0, deferred: 0, urgentDeferred: 0, minCash: START };
    tickEls.forEach((t) => { t.className = ''; });
    mail.hidden = true; tx.hidden = false;
    scene?.reset(START);
    render(); stats();
  }
  function stats(): void {
    const c = byId('sCash'), b = byId('sBudget');
    c.textContent = eur(s.cash); c.classList.toggle('warn', s.cash < SEUIL);
    const pct = s.spent / BUDGET * 100;
    b.textContent = pctOf(pct); b.classList.toggle('warn', pct > 100);
    byId('sDefer').textContent = eur(s.deferred);
    scene?.state(s.cash < SEUIL);
  }
  function render(): void {
    const e = EVENTS[s.i], text = T.events[s.i];
    tickEls.forEach((t, j) => t.classList.toggle('cur', j === s.i));
    tx.style.animation = 'none'; void tx.offsetWidth; tx.style.animation = ''; // restart the card entrance
    byId('txDate').textContent = text.date;
    byId('txCat').textContent = text.cat;
    byId('txDesc').textContent = text.desc;
    const amt = byId('txAmt');
    amt.textContent = (e.k === 'in' ? '+' : '−') + eur(e.amt);
    amt.className = 'tx-amt num ' + (e.k === 'in' ? 'in' : 'out');
    byId('txFlag').textContent = T.flags[e.k];
    pay.textContent = e.k === 'in' ? T.actions.collect : T.actions.pay;
    defer.hidden = e.k === 'in';
    defer.disabled = e.k === 'must';
    defer.textContent = e.k === 'urgent' ? T.actions.deferUrgent : T.actions.defer;
  }
  function act(doPay: boolean): void {
    if (busy || s.i >= EVENTS.length) return;
    const e = EVENTS[s.i];
    let msg: string;
    if (e.k === 'in') { s.cash += e.amt; scene?.income(s.cash); msg = fill(T.live.collected, { amount: eur(e.amt) }); tickEls[s.i].className = 'paid'; }
    else if (doPay) { s.cash -= e.amt; s.spent += e.amt; scene?.pay(s.cash, s.spent); msg = fill(T.live.paid, { amount: eur(e.amt) }); tickEls[s.i].className = 'paid'; }
    else {
      const cost = e.k === 'urgent' ? e.amt * 1.3 : e.amt;
      s.deferred += cost; if (e.k === 'urgent') s.urgentDeferred++;
      scene?.defer(); msg = fill(T.live.deferred, { amount: eur(cost) }); tickEls[s.i].className = 'deferred';
    }
    s.minCash = Math.min(s.minCash, s.cash);
    live.textContent = `${msg} ${fill(T.live.cash, { amount: eur(s.cash) })}` + (s.cash < SEUIL ? T.live.below : '');
    stats();
    s.i++;
    busy = true;
    setTimeout(() => { busy = false; if (s.i < EVENTS.length) render(); else finish(); }, reduced ? 0 : 700);
  }
  function finish(): void {
    const hadFocus = tx.contains(document.activeElement);
    tickEls.forEach((t) => t.classList.remove('cur'));
    const checks: [boolean, string][] = [
      [s.minCash >= SEUIL, fill(T.checks.cash, { amount: eur(s.minCash) })],
      [s.spent <= BUDGET, fill(T.checks.budget, { pct: pctOf(s.spent / BUDGET * 100) })],
      [s.urgentDeferred === 0, s.urgentDeferred ? fill(T.checks.urgentKo, { n: s.urgentDeferred }) : T.checks.urgentOk],
    ];
    const score = checks.filter((c) => c[0]).length;
    byId('mailVerdict').textContent = score === 3 ? T.verdicts[3] : score === 2 ? T.verdicts[2] : T.verdicts.low;
    byId('mailChecks').innerHTML = checks.map(([ok, t]) => `<li class="${ok ? 'ok' : 'ko'}">${ok ? ICON_OK : ICON_KO}<span>${t}</span></li>`).join('');
    byId('mailFigs').innerHTML = [
      [T.figs.cash, eur(s.cash)], [T.figs.spent, eur(s.spent)],
      [T.figs.deferred, eur(s.deferred)], [T.figs.score, fill(T.figs.scoreValue, { n: score })],
    ].map(([a, b]) => `<div><dt>${a}</dt><dd class="num">${b}</dd></div>`).join('');
    tx.hidden = true; mail.hidden = false;
    if (hadFocus) replay.focus({ preventScroll: true });
  }
  pay.addEventListener('click', () => act(true));
  defer.addEventListener('click', () => act(false));
  replay.addEventListener('click', () => { reset(); pay.focus({ preventScroll: true }); });

  reset();
</script>
