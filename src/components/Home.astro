---
/* La page d'accueil complète, rendue dans la langue demandée (voir src/pages). */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Parcours from './Parcours.astro';
import Outils from './Outils.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import Trust from './Trust.astro';
import Capinvest from './Capinvest.astro';
import { showBackground } from '../config';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---

<BaseLayout lang={lang}>
  <Header lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Trust lang={lang} />
    <Projects lang={lang} />
    <Capinvest lang={lang} />
    {showBackground && <Parcours lang={lang} />}
    <Outils lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
