---
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang).tools;
---

<section aria-labelledby="outils-title">
  <div class="wrap sec-head">
    <h2 id="outils-title">{t.title}</h2>
    <p>{t.intro}</p>
  </div>
  <div class="wrap tools">
    {t.groups.map((g) => <div><h3>{g.title}</h3><p>{g.text}</p></div>)}
  </div>
</section>

<style>
  .tools{display:grid; grid-template-columns:repeat(auto-fit, minmax(260px, 1fr)); gap:clamp(28px, 4vw, 56px) clamp(24px, 4vw, 64px); padding-bottom:24px}
  .tools h3{font-size:19px; font-weight:650; letter-spacing:-.01em; padding-bottom:12px; border-bottom:1px solid var(--line); margin-bottom:14px}
  .tools p{color:var(--ink-soft)}
</style>
