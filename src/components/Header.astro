---
import { languages, useTranslations, type Lang } from '../i18n';
import { showBackground } from '../config';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang).header;

const links = [
  { href: '#projets', label: t.nav.projects },
  ...(showBackground ? [{ href: '#parcours', label: t.nav.background }] : []),
  { href: '#contact', label: t.nav.contact },
];
---

<header class="top" id="top">
  <div class="wrap top-inner">
    <a class="brand" href="#main" aria-label={t.brandLabel}>
      <span class="brand-name">M-Solutions</span><span class="brand-by">{t.brandBy}</span>
    </a>
    <nav class="nav" aria-label={t.navLabel}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <nav class="lang-switch" aria-label={t.langLabel}>
      {Object.entries(languages).map(([code, l]) => (
        <a href={l.path} hreflang={code} lang={code} title={l.name} aria-current={code === lang ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .top{
    position:fixed; top:0; left:0; right:0; z-index:50;
    padding-top:env(safe-area-inset-top, 0px);
    transition:background-color .35s ease, border-color .35s ease;
    border-bottom:1px solid transparent;
  }
  .top.scrolled{background:color-mix(in srgb, var(--bg) 82%, transparent); -webkit-backdrop-filter:blur(14px); backdrop-filter:blur(14px); border-color:var(--line-soft)}
  .top-inner{display:flex; align-items:center; gap:24px; height:72px}
  .brand{font-family:var(--display); text-decoration:none; display:flex; flex-direction:column; line-height:1.15; margin-right:auto}
  .brand-name{font-weight:700; letter-spacing:-.02em; font-size:20px}
  .brand-by{font-size:13px; color:var(--ink-faint)}
  .nav{display:flex; gap:4px}
  .nav a{font-family:var(--display); font-weight:500; font-size:16px; text-decoration:none; color:var(--ink-soft); padding:10px 14px; border-radius:999px; transition:color .2s ease, background-color .2s ease}
  .nav a:hover{color:var(--ink); background:var(--line-soft)}
  @media (max-width:760px){ .nav{display:none} }
  /* choix de la langue : toujours visible, y compris sur mobile */
  .lang-switch{display:flex; gap:2px; padding:3px; border:1px solid var(--line); border-radius:999px}
  .lang-switch a{font-family:var(--display); font-weight:600; font-size:14px; letter-spacing:.01em; text-decoration:none; color:var(--ink-soft); min-width:44px; min-height:36px; display:grid; place-items:center; padding:0 10px; border-radius:999px; transition:color .2s ease, background-color .2s ease}
  .lang-switch a:hover{color:var(--ink); background:var(--line-soft)}
  .lang-switch a[aria-current="page"]{background:var(--ink); color:var(--bg-deep)}
</style>

<script>
  import { byId } from '../scripts/motion';

  const top = byId('top');
  const onScroll = () => top.classList.toggle('scrolled', scrollY > 24);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
