---
import CodeIcon from './icons/CodeIcon.astro';
import ExternalIcon from './icons/ExternalIcon.astro';
import CashGame from './CashGame.astro';
import { useTranslations, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = useTranslations(lang);
const t = dict.ahla;

const cards = [
  { id: 'card-dash', src: '/images/ahla-tableau-de-bord.webp', height: 735, ...t.cards.dash },
  { id: 'card-budget', src: '/images/ahla-budget.webp', height: 734, ...t.cards.budget },
  { id: 'card-portal', src: '/images/ahla-portail.webp', height: 695, ...t.cards.portal },
];
---

<article class="project flip" aria-labelledby="ahla-title">
  <div class="wrap project-grid has-steps">
    <div class="project-text">
      <div class="p-meta">
        <span class="tag live">{t.tags.live}</span>
        <span class="tag">{t.tags.role}</span>
        <span class="tag">{t.tags.period}</span>
      </div>
      <h3 id="ahla-title">Ahla Cashflow</h3>
      <p class="p-sub">{t.sub}</p>
      <ul class="p-list">
        {t.list.map((item) => <li set:html={item} />)}
      </ul>
      <div class="p-links">
        <a class="btn primary" href="https://ahlapp.com" target="_blank" rel="noopener"><ExternalIcon />{t.open}</a>
        <a class="btn" href="https://github.com/MikoOwO/ahla-cashflow-hub/tree/main" target="_blank" rel="noopener"><CodeIcon />{dict.projects.sourceCode}</a>
      </div>
    </div>
    <div class="steps-track" id="deckTrack" style={`--steps:${cards.length}`}>
      <div class="deck reveal steps-sticky" id="deck">
        <div class="deck-cards" id="deckCards">
          {cards.map((c, i) => (
            <figure class="deck-card" data-pos={i} id={c.id}><img src={c.src} width="1400" height={c.height} alt={c.alt} loading="lazy" /></figure>
          ))}
        </div>
        <div class="deck-tabs" role="tablist" aria-label={t.tabsLabel}>
          {cards.map((c, i) => (
            <button role="tab" type="button" aria-selected={i === 0 ? 'true' : 'false'} aria-controls={c.id} data-card={c.id} tabindex={i === 0 ? undefined : -1} data-cap={c.cap}>{c.tab}</button>
          ))}
        </div>
        <p class="deck-caption" id="deckCap" aria-live="polite">{cards[0].cap}</p>
      </div>
    </div>
  </div>

  <CashGame lang={lang} />
</article>

<style>
  /* ---- 3D screenshot deck ---- */
  .deck{perspective:1800px} /* positionné par .steps-sticky */
  .deck-cards{position:relative; aspect-ratio:1400/735; transform-style:preserve-3d}
  .deck-card{
    position:absolute; inset:0; margin:0; border-radius:14px; overflow:hidden; border:1px solid var(--line); background:var(--surface);
    transition:transform .8s var(--ease-out), opacity .6s ease, filter .6s ease;
    box-shadow:0 30px 60px -28px rgba(0,0,0,.7);
  }
  .deck-card img{width:100%; height:100%; object-fit:cover; object-position:top left}
  .deck-card[data-pos="0"]{transform:translate3d(0,0,0) rotateY(0); z-index:3}
  .deck-card[data-pos="1"]{transform:translate3d(7%,-9%,-140px) rotateY(-14deg); z-index:2; filter:brightness(.55) saturate(.8)}
  .deck-card[data-pos="2"]{transform:translate3d(13%,-17%,-280px) rotateY(-20deg); z-index:1; filter:brightness(.35) saturate(.6)}
  .deck-tabs{display:flex; flex-wrap:wrap; gap:8px; margin-top:28px; padding:6px; border:1px solid var(--line); border-radius:16px; width:fit-content; max-width:100%; background:color-mix(in srgb, var(--bg-deep) 60%, transparent)}
  .deck-tabs button{font-family:var(--display); font-weight:600; font-size:15px; min-height:44px; padding:0 16px; border-radius:11px; border:0; cursor:pointer; color:var(--ink-soft); background:transparent; transition:background-color .25s ease, color .25s ease}
  .deck-tabs button[aria-selected="true"]{background:var(--ink); color:var(--bg-deep)}
</style>

<script>
  import { byId } from '../scripts/motion';
  import { initTabs } from '../scripts/tabs';
  import { initScrollSteps, observeStickyHeight } from '../scripts/scroll-steps';

  const deck = byId('deck');
  const tabs = [...deck.querySelectorAll<HTMLElement>('.deck-tabs [role="tab"]')];
  const cards = [...byId('deckCards').querySelectorAll<HTMLElement>('.deck-card')];
  const cap = byId('deckCap');

  /* the chosen card comes to the front, the others keep their order behind;
     cards follow the scroll, a tab (or a card) click scrolls to its screen */
  const show = initTabs(tabs, (_i, tab) => {
    const active = tab.dataset.card;
    const rest = cards.map((c) => c.id).filter((id) => id !== active);
    [active, ...rest].forEach((id, pos) => { byId(id ?? '').dataset.pos = String(pos); });
    cap.textContent = tab.dataset.cap ?? '';
  }, (i) => goTo(i));
  const goTo = initScrollSteps(byId('deckTrack'), deck, tabs.length, show);
  observeStickyHeight(deck.closest('.project-grid')?.querySelector('.project-text') ?? deck);
  cards.forEach((c) => c.addEventListener('click', () => {
    const i = tabs.findIndex((t) => t.dataset.card === c.id);
    if (c.dataset.pos !== '0') { show(i); goTo(i); }
  }));
</script>
